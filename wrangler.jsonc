{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apps",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7d0d51e3-2b11-4899-a31d-f6766ab76b05","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4fb2a6732f9f411baa997a70ed20e4e6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
